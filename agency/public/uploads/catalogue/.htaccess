# Uploaded catalogue PDFs — no script execution
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

<FilesMatch "(?i)\.(php|phtml|php[0-9]|phar|cgi|pl|asp|aspx|jsp|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Cache-Control "public, max-age=86400"
</IfModule>

<FilesMatch "\.pdf$">
  <IfModule mod_headers.c>
    Header set Content-Type "application/pdf"
    Header set Content-Disposition "inline"
  </IfModule>
</FilesMatch>
