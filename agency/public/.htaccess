# SPA + SEO for DisplayAvenue (https://displayavenue.com/)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force apex domain (www → non-www)
  RewriteCond %{HTTP_HOST} ^www\.displayavenue\.com$ [NC]
  RewriteRule ^(.*)$ https://displayavenue.com/$1 [R=301,L]

  # Dynamic sitemap
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Existing files/directories are served as-is
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # All other routes go through the SEO router (unique meta + real 404s)
  RewriteRule ^ seo-router.php [L,QSA]
</IfModule>
