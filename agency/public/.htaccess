# SPA + SEO + security for DisplayAvenue (https://displayavenue.com/)
Options -Indexes

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header unset X-Powered-By

  # HTML must never be cached — desktop browsers otherwise keep old asset hashes
  # and load a broken/unstyled site after deploys.
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header unset ETag
  </FilesMatch>
  <Files "index.html">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header unset ETag
  </Files>

  # Hashed JS/CSS can be cached aggressively
  <FilesMatch "\.(?:js|css|woff2?|ttf|otf|svg|png|jpe?g|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # CMS JSON should stay fresh
  <FilesMatch "\.(json)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>

# Block common sensitive / toolchain files if ever uploaded
<FilesMatch "(?i)^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (Hostinger usually redirects already; keep as belt-and-suspenders)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Old /demo URLs → root
  RewriteRule ^demo/?(.*)$ /$1 [R=301,L]

  # Live auto sitemap (always generated from CMS JSON)
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^sitemap\.xsl$ - [L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
