# SPA + SEO for DisplayAvenue (https://displayavenue.com/)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Dynamic sitemap
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
