# SPA + SEO for DisplayAvenue (https://displayavenue.com/)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Dynamic sitemap
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Hostinger quotations (public client links)
  RewriteRule ^q(/.*)?$ /q/index.php [L,QSA]

  # Tax invoice demo / future invoice pages
  RewriteRule ^invoice/demo/?$ /invoice/demo/index.html [L]
  RewriteRule ^invoice/([A-Za-z0-9._-]+)/([A-Za-z0-9_-]+)/?$ /invoice/view.php?number=$1&token=$2 [L,QSA]

  # Blog indexable SEO shells (correct canonical/meta for crawlers)
  RewriteRule ^blog/?$ /blog-seo.php [L,QSA]
  RewriteRule ^blog/([A-Za-z0-9._-]+)/?$ /blog-seo.php?slug=$1 [L,QSA]

  # Videos SEO shell + lazy daily reel publish
  RewriteRule ^videos/?$ /videos-seo.php [L,QSA]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
