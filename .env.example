# JyotishKundali — Environment Variables
# Copy to .env and fill in. Never commit secrets.

# ─── Site & Brand ─────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# On Vercel production, set to the deployment URL or https://app.jyotishkundali.com
NEXT_PUBLIC_SITE_DOMAIN=jyotishkundali.com
NEXT_PUBLIC_BRAND_NAME=JyotishKundali
NEXT_PUBLIC_TAGLINE=Know Yourself. Understand Your Path.

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/jyotishkundali?schema=public

# ─── Auth ─────────────────────────────────────────────────
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ─── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── Astrology API ────────────────────────────────────────
ASTROLOGY_API_URL=
ASTROLOGY_API_KEY=
ASTROLOGY_API_PROVIDER=prokerala
SWISS_EPHEMERIS_PATH=

# ─── AI (Report Interpretation) ─────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gpt-4o-mini
AI_REPORT_INTERPRETATION=true

# ─── Storage (PDF / Assets) ─────────────────────────────────
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Alternative: Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ─── Email ────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=noreply@jyotishkundali.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ─── WhatsApp ─────────────────────────────────────────────
WHATSAPP_PROVIDER=interakt
INTERAKT_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ─── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ─── Analytics ────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# ─── Development ──────────────────────────────────────────
USE_MOCK_PROVIDERS=true
JYOTISH_MODE=development
