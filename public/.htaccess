# DisplayAvenue Realty - SPA routing for Hostinger/Apache
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite SEO / static discovery files to the SPA
  RewriteRule ^(sitemap\.xml|sitemap_index\.xml|sitemap\.php|robots\.txt|llms\.txt|favicon\.svg)$ - [L]

  RewriteRule ^$ index.html [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/xml .xml
  AddCharset utf-8 .xml .txt
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Force correct type for sitemaps; do not set Content-Length or noindex
  <FilesMatch "^(sitemap\.xml|sitemap_index\.xml)$">
    Header set Content-Type "application/xml; charset=utf-8"
    Header unset Content-Length
  </FilesMatch>
  <FilesMatch "^(robots\.txt|llms\.txt)$">
    Header set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
