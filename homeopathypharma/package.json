{
  "name": "homeopathypharma",
  "private": true,
  "version": "0.1.0",
  "description": "HomeopathyPharma.com — global homeopathy healthcare + ecommerce platform",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@homeopathypharma/web",
    "dev:doctor": "turbo run dev --filter=@homeopathypharma/doctor",
    "dev:admin": "turbo run dev --filter=@homeopathypharma/admin",
    "dev:api": "turbo run dev --filter=@homeopathypharma/api",
    "dev:worker": "turbo run dev --filter=@homeopathypharma/worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @homeopathypharma/e2e test",
    "db:generate": "pnpm --filter @homeopathypharma/database generate",
    "db:migrate": "pnpm --filter @homeopathypharma/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @homeopathypharma/database migrate:deploy",
    "db:seed": "pnpm --filter @homeopathypharma/database seed",
    "db:studio": "pnpm --filter @homeopathypharma/database studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infrastructure/docker/docker-compose.yml logs -f",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
