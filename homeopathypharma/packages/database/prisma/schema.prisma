// HomeopathyPharma.com — PostgreSQL schema (Prisma)
// Backend is source of truth. Soft-delete via deletedAt where appropriate.
// Money ledgers, order snapshots, approvals, and publish histories are immutable.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────

enum UserAccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
  DELETED
}

enum IdentityProvider {
  GOOGLE
  EMAIL_OTP
  PHONE_OTP
  PASSWORD
}

enum PublishStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
  REJECTED
}

enum MedicalReviewStatus {
  NOT_REQUIRED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  NEEDS_UPDATE
}

enum DoctorVerificationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  NEEDS_MORE_INFO
  APPROVED
  REJECTED
  SUSPENDED
}

enum AppointmentMode {
  ONLINE
  OFFLINE
}

enum AppointmentStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum PaymentProvider {
  RAZORPAY
  WALLET
  MANUAL
}

enum ShipmentStatus {
  PENDING
  READY_TO_SHIP
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  NDR
  RTO
  CANCELLED
  RETURNED
}

enum InventoryMovementType {
  RECEIPT
  SALE
  RESERVATION
  RELEASE
  ADJUSTMENT
  RETURN
  EXPIRE
  TRANSFER
}

enum ReviewModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
  REMOVED
}

enum ReviewQueueType {
  PRODUCT
  DOCTOR
}

enum ReviewQueueItemStatus {
  PENDING
  IN_REVIEW
  RESOLVED
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
  REFERRAL
  BUNDLE
}

enum ReferralLedgerEntryType {
  ACCRUAL
  REVERSAL
  PAYOUT
  ADJUSTMENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum PageKind {
  COMMERCE
  CONTENT
  LEGAL
  LANDING
  SYSTEM
}

enum SitemapSegment {
  PRODUCTS
  CATEGORIES
  CONDITIONS
  BODY_SYSTEMS
  ORGANS
  DOCTORS
  CITIES
  PETS
  ARTICLES
  STATIC
  LEGAL
}

enum ConsentType {
  TERMS
  PRIVACY
  MARKETING
  MEDICAL_TELECONSULT
  COOKIES
}

// ─── Identity & Access ───────────────────────────────────────

model User {
  id                String            @id @default(cuid())
  email             String?           @unique
  emailVerifiedAt   DateTime?
  phone             String?           @unique
  phoneVerifiedAt   DateTime?
  displayName       String?
  avatarUrl         String?
  status            UserAccountStatus @default(PENDING)
  preferredLocale   String            @default("en-IN")
  preferredCountry  String            @default("IN")
  preferredCurrency String            @default("INR")
  lastLoginAt       DateTime?
  lockedUntil       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdById       String?
  updatedById       String?
  deletedAt         DateTime?

  identities      UserIdentity[]
  sessions        Session[]
  roles           UserRole[]
  mfaDevices      MfaDevice[]
  loginAttempts   LoginAttempt[]
  auditLogs       AuditLog[]       @relation("AuditActor")
  customerProfile CustomerProfile?
  doctorProfile   DoctorProfile?
  consents        Consent[]
  privacyEvents   PrivacyEvent[]
  supportTickets  SupportTicket[]  @relation("TicketRequester")
  notifications   Notification[]
  savedItems      SavedItem[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model UserIdentity {
  id             String           @id @default(cuid())
  userId         String
  provider       IdentityProvider
  providerUserId String
  email          String?
  rawProfile     Json?
  verifiedAt     DateTime?
  status         String           @default("ACTIVE")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_identities")
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  deviceId       String?
  deviceLabel    String?
  ipAddress      String?
  userAgent      String?
  status         String    @default("ACTIVE")
  expiresAt      DateTime
  revokedAt      DateTime?
  lastSeenAt     DateTime?
  forcedLogoutAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  createdById  String?

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id          String    @id @default(cuid())
  userId      String
  roleId      String
  status      String    @default("ACTIVE")
  assignedAt  DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model MfaDevice {
  id          String    @id @default(cuid())
  userId      String
  type        String
  label       String?
  secretEnc   String?
  status      String    @default("PENDING")
  verifiedAt  DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@map("mfa_devices")
}

model LoginAttempt {
  id            String            @id @default(cuid())
  userId        String?
  emailOrPhone  String?
  ipAddress     String?
  userAgent     String?
  provider      IdentityProvider?
  success       Boolean
  failureReason String?
  createdAt     DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([emailOrPhone, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
  @@map("login_attempts")
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  action        String
  entityType    String
  entityId      String?
  beforeJson    Json?
  afterJson     Json?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  immutable     Boolean  @default(true)
  createdAt     DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─── Customer ────────────────────────────────────────────────

model CustomerProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  firstName      String?
  lastName       String?
  dateOfBirth    DateTime?
  gender         String?
  status         String    @default("ACTIVE")
  referredByCode String?
  ownerUserId    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  user            User                   @relation(fields: [userId], references: [id])
  addresses       CustomerAddress[]
  preferences     CustomerPreference?
  wallet          CustomerWallet?
  referrals       CustomerReferral[]     @relation("ReferredCustomer")
  notifications   CustomerNotification[]
  carts           Cart[]
  orders          Order[]
  appointments    DoctorAppointment[]
  productReviews  ProductReview[]
  doctorReviews   DoctorReview[]
  customerCoupons CustomerCoupon[]

  @@index([status])
  @@map("customer_profiles")
}

model CustomerAddress {
  id          String    @id @default(cuid())
  customerId  String
  label       String?
  name        String
  phone       String?
  line1       String
  line2       String?
  city        String
  state       String?
  postalCode  String
  countryCode String    @default("IN")
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  isDefault   Boolean   @default(false)
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  customer CustomerProfile @relation(fields: [customerId], references: [id])

  @@index([customerId, status])
  @@map("customer_addresses")
}

model CustomerPreference {
  id                  String   @id @default(cuid())
  customerId          String   @unique
  marketingEmailOptIn Boolean  @default(false)
  marketingSmsOptIn   Boolean  @default(false)
  whatsappOptIn       Boolean  @default(false)
  petInterest         Boolean  @default(false)
  locale              String   @default("en-IN")
  currency            String   @default("INR")
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdById         String?
  updatedById         String?

  customer CustomerProfile @relation(fields: [customerId], references: [id])

  @@map("customer_preferences")
}

model CustomerWallet {
  id           String   @id @default(cuid())
  customerId   String   @unique
  currency     String   @default("INR")
  balanceMinor Int      @default(0)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?
  updatedById  String?

  customer CustomerProfile @relation(fields: [customerId], references: [id])

  @@map("customer_wallets")
}

model CustomerReferral {
  id                String   @id @default(cuid())
  customerId        String
  referralCodeId    String
  referringDoctorId String?
  orderId           String?
  status            String   @default("ATTRIBUTED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?
  updatedById       String?

  customer     CustomerProfile    @relation("ReferredCustomer", fields: [customerId], references: [id])
  referralCode DoctorReferralCode @relation(fields: [referralCodeId], references: [id])

  @@index([customerId])
  @@index([referralCodeId])
  @@map("customer_referrals")
}

model CustomerNotification {
  id          String              @id @default(cuid())
  customerId  String
  channel     NotificationChannel
  title       String
  body        String
  payload     Json?
  status      String              @default("PENDING")
  readAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdById String?
  updatedById String?

  customer CustomerProfile @relation(fields: [customerId], references: [id])

  @@index([customerId, status])
  @@map("customer_notifications")
}

model SavedItem {
  id          String    @id @default(cuid())
  userId      String
  productId   String?
  variantId   String?
  bundleId    String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@map("saved_items")
}

// ─── Doctor ──────────────────────────────────────────────────

model DoctorProfile {
  id                   String                   @id @default(cuid())
  userId               String                   @unique
  slug                 String                   @unique
  title                String?
  fullName             String
  bio                  String?
  consultationFeeMinor Int                      @default(0)
  currency             String                   @default("INR")
  yearsExperience      Int?
  verificationStatus   DoctorVerificationStatus @default(DRAFT)
  verifiedBadge        Boolean                  @default(false)
  vacationMode         Boolean                  @default(false)
  status               PublishStatus            @default(DRAFT)
  ownerUserId          String?
  publishedAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  createdById          String?
  updatedById          String?
  deletedAt            DateTime?

  user           User                     @relation(fields: [userId], references: [id])
  verifications  DoctorVerification[]
  documents      DoctorDocument[]
  licenses       DoctorLicense[]
  specialties    DoctorSpecialty[]
  languages      DoctorLanguage[]
  clinics        DoctorClinic[]
  availability   DoctorAvailabilitySlot[]
  appointments   DoctorAppointment[]
  consultations  DoctorConsultation[]
  reviews        DoctorReview[]
  referralCodes  DoctorReferralCode[]
  payouts        DoctorPayout[]
  earningsLedger DoctorEarningsLedger[]

  @@index([verificationStatus, status])
  @@index([slug])
  @@map("doctor_profiles")
}

model DoctorVerification {
  id          String                   @id @default(cuid())
  doctorId    String
  status      DoctorVerificationStatus @default(SUBMITTED)
  notes       String?
  reviewerId  String?
  reviewedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  createdById String?
  updatedById String?

  doctor DoctorProfile @relation(fields: [doctorId], references: [id])

  @@index([doctorId, status])
  @@map("doctor_verifications")
}

model DoctorDocument {
  id           String    @id @default(cuid())
  doctorId     String
  documentType String
  storageKey   String
  mimeType     String
  fileName     String
  status       String    @default("UPLOADED")
  scannedAt    DateTime?
  scanResult   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?

  doctor     DoctorProfile       @relation(fields: [doctorId], references: [id])
  accessLogs DocumentAccessLog[]

  @@index([doctorId, status])
  @@map("doctor_documents")
}

model DoctorLicense {
  id            String    @id @default(cuid())
  doctorId      String
  licenseNumber String
  issuingBody   String
  countryCode   String    @default("IN")
  state         String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?
  updatedById   String?
  deletedAt     DateTime?

  doctor DoctorProfile @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, licenseNumber, issuingBody])
  @@map("doctor_licenses")
}

model DoctorSpecialty {
  id          String   @id @default(cuid())
  doctorId    String
  specialty   String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  doctor DoctorProfile @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, specialty])
  @@map("doctor_specialties")
}

model DoctorLanguage {
  id           String   @id @default(cuid())
  doctorId     String
  languageCode String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?
  updatedById  String?

  doctor DoctorProfile @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, languageCode])
  @@map("doctor_languages")
}

model DoctorClinic {
  id          String    @id @default(cuid())
  doctorId    String
  name        String
  line1       String
  line2       String?
  city        String
  state       String?
  postalCode  String?
  countryCode String    @default("IN")
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  phone       String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  doctor       DoctorProfile       @relation(fields: [doctorId], references: [id])
  appointments DoctorAppointment[]

  @@index([doctorId, city])
  @@map("doctor_clinics")
}

model DoctorAvailabilitySlot {
  id          String          @id @default(cuid())
  doctorId    String
  clinicId    String?
  mode        AppointmentMode
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int             @default(1)
  bookedCount Int             @default(0)
  status      String          @default("OPEN")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  doctor       DoctorProfile       @relation(fields: [doctorId], references: [id])
  appointments DoctorAppointment[]

  @@index([doctorId, startsAt, status])
  @@index([mode, startsAt])
  @@map("doctor_availability_slots")
}

model DoctorAppointment {
  id                 String            @id @default(cuid())
  doctorId           String
  customerId         String
  slotId             String?
  clinicId           String?
  mode               AppointmentMode
  status             AppointmentStatus @default(DRAFT)
  scheduledStart     DateTime
  scheduledEnd       DateTime
  feeMinor           Int               @default(0)
  currency           String            @default("INR")
  paymentId          String?
  idempotencyKey     String?           @unique
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  createdById        String?
  updatedById        String?

  doctor        DoctorProfile           @relation(fields: [doctorId], references: [id])
  customer      CustomerProfile         @relation(fields: [customerId], references: [id])
  slot          DoctorAvailabilitySlot? @relation(fields: [slotId], references: [id])
  clinic        DoctorClinic?           @relation(fields: [clinicId], references: [id])
  consultation  DoctorConsultation?
  doctorReviews DoctorReview[]

  @@index([doctorId, scheduledStart])
  @@index([customerId, status])
  @@index([status, scheduledStart])
  @@map("doctor_appointments")
}

model DoctorConsultation {
  id                  String    @id @default(cuid())
  appointmentId       String    @unique
  doctorId            String
  roomId              String?
  waitingRoomJoinedAt DateTime?
  startedAt           DateTime?
  endedAt             DateTime?
  status              String    @default("SCHEDULED")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdById         String?
  updatedById         String?

  appointment   DoctorAppointment    @relation(fields: [appointmentId], references: [id])
  doctor        DoctorProfile        @relation(fields: [doctorId], references: [id])
  notes         ConsultationNote[]
  prescriptions DoctorPrescription[]

  @@index([doctorId, status])
  @@map("doctor_consultations")
}

model ConsultationNote {
  id             String   @id @default(cuid())
  consultationId String
  authorUserId   String
  noteBody       String
  isPrivate      Boolean  @default(true)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  updatedById    String?

  consultation DoctorConsultation @relation(fields: [consultationId], references: [id])

  @@index([consultationId])
  @@map("consultation_notes")
}

model DoctorPrescription {
  id             String   @id @default(cuid())
  consultationId String
  storageKey     String?
  body           String?
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  updatedById    String?

  consultation DoctorConsultation @relation(fields: [consultationId], references: [id])

  @@index([consultationId])
  @@map("doctor_prescriptions")
}

model DoctorReview {
  id               String                 @id @default(cuid())
  doctorId         String
  customerId       String
  appointmentId    String
  rating           Int
  title            String?
  body             String?
  verifiedConsult  Boolean                @default(true)
  moderationStatus ReviewModerationStatus @default(PENDING)
  status           String                 @default("ACTIVE")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  createdById      String?
  updatedById      String?
  deletedAt        DateTime?

  doctor      DoctorProfile     @relation(fields: [doctorId], references: [id])
  customer    CustomerProfile   @relation(fields: [customerId], references: [id])
  appointment DoctorAppointment @relation(fields: [appointmentId], references: [id])

  @@unique([appointmentId, customerId])
  @@index([doctorId, moderationStatus])
  @@map("doctor_reviews")
}

model DoctorReferralCode {
  id                 String    @id @default(cuid())
  doctorId           String
  code               String    @unique
  discountPercent    Decimal?  @db.Decimal(5, 2)
  discountFixedMinor Int?
  commissionPercent  Decimal   @db.Decimal(5, 2)
  maxRedemptions     Int?
  perCustomerLimit   Int       @default(1)
  status             String    @default("ACTIVE")
  startsAt           DateTime?
  endsAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?
  updatedById        String?
  deletedAt          DateTime?

  doctor              DoctorProfile        @relation(fields: [doctorId], references: [id])
  referrals           CustomerReferral[]
  rules               ReferralRule[]
  doctorReferralRules DoctorReferralRule[]

  @@index([doctorId, status])
  @@map("doctor_referral_codes")
}

model DoctorPayout {
  id          String    @id @default(cuid())
  doctorId    String
  amountMinor Int
  currency    String    @default("INR")
  status      String    @default("PENDING")
  periodStart DateTime?
  periodEnd   DateTime?
  paidAt      DateTime?
  reference   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  doctor DoctorProfile @relation(fields: [doctorId], references: [id])

  @@index([doctorId, status])
  @@map("doctor_payouts")
}

/// Immutable earnings ledger — no soft deletes
model DoctorEarningsLedger {
  id             String                  @id @default(cuid())
  doctorId       String
  entryType      ReferralLedgerEntryType
  amountMinor    Int
  currency       String                  @default("INR")
  orderId        String?
  appointmentId  String?
  referralCodeId String?
  description    String?
  createdAt      DateTime                @default(now())
  createdById    String?

  doctor DoctorProfile @relation(fields: [doctorId], references: [id])

  @@index([doctorId, createdAt])
  @@index([orderId])
  @@map("doctor_earnings_ledger")
}

// ─── Catalog ─────────────────────────────────────────────────

model Brand {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  description        String?
  logoStorageKey     String?
  countryCode        String?
  officialWebsiteUrl String?
  regulatoryNotes    String?
  seoTitle           String?
  seoDescription     String?
  status             PublishStatus @default(DRAFT)
  ownerUserId        String?
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  createdById        String?
  updatedById        String?
  deletedAt          DateTime?

  products      Product[]
  manufacturers BrandManufacturerMap[]
  documents     BrandDocument[]

  @@index([status])
  @@map("brands")
}

model Manufacturer {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  legalName    String?
  countryCode  String?
  addressLine1 String?
  city         String?
  state        String?
  postalCode   String?
  licenseInfo  String?
  gmpNotes     String?
  contactEmail String?
  contactPhone String?
  status       PublishStatus @default(DRAFT)
  ownerUserId  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?

  products Product[]
  brands   BrandManufacturerMap[]

  @@index([status])
  @@map("manufacturers")
}

model Category {
  id          String        @id @default(cuid())
  parentId    String?
  /// Store taxonomy root kind: MEDICINES | WELLNESS | PET_CARE | BUNDLES | BOOKS | OFFERS
  /// Body systems/conditions/symptoms/remedies stay in their own entity tables.
  treeKind    String        @default("MEDICINES")
  name        String
  slug        String        @unique
  description String?
  status      PublishStatus @default(DRAFT)
  ownerUserId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  parent      Category?            @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]           @relation("CategoryTree")
  products    Product[]
  productMaps ProductCategoryMap[]

  @@index([parentId])
  @@index([treeKind, status])
  @@map("categories")
}

model ProductGroup {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  status      PublishStatus @default(DRAFT)
  ownerUserId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  products Product[]

  @@map("product_groups")
}

model Product {
  id                  String              @id @default(cuid())
  brandId             String?
  manufacturerId      String?
  categoryId          String?
  productGroupId      String?
  name                String
  slug                String              @unique
  subtitle            String?
  description         String?
  directions          String?
  warnings            String?
  returnPolicy        String?
  status              PublishStatus       @default(DRAFT)
  medicalReviewStatus MedicalReviewStatus @default(NOT_REQUIRED)
  ownerUserId         String?
  publishedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  createdById         String?
  updatedById         String?
  deletedAt           DateTime?

  brand           Brand?                 @relation(fields: [brandId], references: [id])
  manufacturer    Manufacturer?          @relation(fields: [manufacturerId], references: [id])
  category        Category?              @relation(fields: [categoryId], references: [id])
  productGroup    ProductGroup?          @relation(fields: [productGroupId], references: [id])
  variants        ProductVariant[]
  images          ProductImage[]
  tags            ProductTag[]
  contentBlocks   ProductContentBlock[]
  ingredients     ProductIngredient[]
  relationships   ProductRelationship[]  @relation("ProductFrom")
  relatedFrom     ProductRelationship[]  @relation("ProductTo")
  faqs            ProductFaq[]
  reviews         ProductReview[]
  bundleItems     BundleItem[]
  categoryMaps    ProductCategoryMap[]
  remedyMaps      ProductRemedyMap[]
  healthAreaMaps  ProductHealthAreaMap[]
  badgeMaps       ProductBadgeMap[]
  conditionMaps   ConditionProductMap[]
  storageNotes    String?
  countryOfOrigin String?                @default("IN")

  @@index([status, publishedAt])
  @@index([brandId])
  @@index([categoryId])
  @@map("products")
}

/// Variant is the sellable SKU truth for price/stock identity
model ProductVariant {
  id                   String    @id @default(cuid())
  productId            String
  sku                  String    @unique
  barcode              String?
  gtin                 String?
  /// Legacy free-text snapshots — prefer FKs below for truth
  potency              String?
  packSize             String?
  form                 String?
  dosageFormId         String?
  potencyId            String?
  packQuantity         Decimal?  @db.Decimal(12, 3)
  packUnit             String?
  netQuantityLabel     String?
  title                String
  currency             String    @default("INR")
  mrpMinor             Int?
  priceMinor           Int
  compareAtMinor       Int?
  taxCode              String?
  weightGrams          Int?
  prescriptionRequired Boolean   @default(false)
  ageRestrictionNote   String?
  countryOfOrigin      String?   @default("IN")
  status               String    @default("ACTIVE")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdById          String?
  updatedById          String?
  deletedAt            DateTime?

  product           Product            @relation(fields: [productId], references: [id])
  dosageForm        DosageForm?        @relation(fields: [dosageFormId], references: [id])
  potencyRef        Potency?           @relation(fields: [potencyId], references: [id])
  inventoryBatches  InventoryBatch[]
  stockReservations StockReservation[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  bundleItems       BundleItem[]

  @@index([productId, status])
  @@index([dosageFormId])
  @@index([potencyId])
  @@map("product_variants")
}

model ProductImage {
  id          String    @id @default(cuid())
  productId   String
  storageKey  String
  altText     String?
  sortOrder   Int       @default(0)
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductTag {
  id          String   @id @default(cuid())
  productId   String
  tag         String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, tag])
  @@map("product_tags")
}

model ProductContentBlock {
  id          String   @id @default(cuid())
  productId   String
  blockType   String
  title       String?
  body        String
  sortOrder   Int      @default(0)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, sortOrder])
  @@map("product_content_blocks")
}

model ProductIngredient {
  id          String   @id @default(cuid())
  productId   String
  name        String
  potency     String?
  quantity    String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_ingredients")
}

model ProductRelationship {
  id               String   @id @default(cuid())
  productId        String
  relatedProductId String
  relationType     String
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String?
  updatedById      String?

  product        Product @relation("ProductFrom", fields: [productId], references: [id])
  relatedProduct Product @relation("ProductTo", fields: [relatedProductId], references: [id])

  @@unique([productId, relatedProductId, relationType])
  @@map("product_relationships")
}

model ProductFaq {
  id          String   @id @default(cuid())
  productId   String
  question    String
  answer      String
  sortOrder   Int      @default(0)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, sortOrder])
  @@map("product_faqs")
}

/// Standalone ingredient catalog — normalized names for search, SEO, and cross-product linking
model Ingredient {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  scientificName String?
  description    String?
  status         PublishStatus @default(DRAFT)
