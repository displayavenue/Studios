  subtotalMinor    Int
  discountMinor    Int         @default(0)
  shippingMinor    Int         @default(0)
  taxMinor         Int         @default(0)
  totalMinor       Int
  status           OrderStatus @default(PENDING_PAYMENT)
  shippingSnapshot Json?
  billingSnapshot  Json?
  pricingSnapshot  Json
  idempotencyKey   String?     @unique
  placedAt         DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  createdById      String?
  updatedById      String?

  customer      CustomerProfile      @relation(fields: [customerId], references: [id])
  checkout      Checkout?            @relation(fields: [checkoutId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  shipments     Shipment[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

/// Immutable line snapshots once order is placed
model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  variantId        String?
  skuSnapshot      String
  titleSnapshot    String
  potencySnapshot  String?
  packSizeSnapshot String?
  unitPriceMinor   Int
  quantity         Int
  lineTotalMinor   Int
  currency         String   @default("INR")
  createdAt        DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  createdAt   DateTime     @default(now())
  createdById String?

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String?
  appointmentId     String?
  provider          PaymentProvider
  providerOrderId   String?
  providerPaymentId String?
  amountMinor       Int
  currency          String          @default("INR")
  status            PaymentStatus   @default(CREATED)
  idempotencyKey    String?         @unique
  rawPayload        Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdById       String?
  updatedById       String?

  order    Order?           @relation(fields: [orderId], references: [id])
  attempts PaymentAttempt[]
  refunds  Refund[]

  @@index([orderId])
  @@index([providerOrderId])
  @@index([status])
  @@map("payments")
}

model PaymentAttempt {
  id              String        @id @default(cuid())
  paymentId       String
  status          PaymentStatus
  providerPayload Json?
  errorCode       String?
  createdAt       DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  amountMinor      Int
  currency         String   @default("INR")
  reason           String?
  status           String   @default("PENDING")
  providerRefundId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String?
  updatedById      String?

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId, status])
  @@map("refunds")
}

// ─── Inventory / Shipping ────────────────────────────────────

model Warehouse {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  line1       String
  city        String
  state       String?
  postalCode  String?
  countryCode String    @default("IN")
  status      String    @default("ACTIVE")
  ownerUserId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  batches   InventoryBatch[]
  shipments Shipment[]

  @@map("warehouses")
}

model InventoryBatch {
  id               String    @id @default(cuid())
  warehouseId      String
  variantId        String
  batchNumber      String
  quantityOnHand   Int       @default(0)
  quantityReserved Int       @default(0)
  manufacturedAt   DateTime?
  expiresAt        DateTime?
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?
  updatedById      String?

  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  variant      ProductVariant      @relation(fields: [variantId], references: [id])
  movements    InventoryMovement[]
  reservations StockReservation[]

  @@unique([warehouseId, variantId, batchNumber])
  @@index([variantId, expiresAt])
  @@map("inventory_batches")
}

model InventoryMovement {
  id            String                @id @default(cuid())
  batchId       String
  movementType  InventoryMovementType
  quantity      Int
  referenceType String?
  referenceId   String?
  note          String?
  createdAt     DateTime              @default(now())
  createdById   String?

  batch InventoryBatch @relation(fields: [batchId], references: [id])

  @@index([batchId, createdAt])
  @@map("inventory_movements")
}

model StockReservation {
  id          String    @id @default(cuid())
  batchId     String
  variantId   String
  orderId     String?
  quantity    Int
  status      String    @default("RESERVED")
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  batch   InventoryBatch @relation(fields: [batchId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId, status])
  @@map("stock_reservations")
}

model Shipment {
  id                 String         @id @default(cuid())
  orderId            String
  warehouseId        String?
  provider           String         @default("SHIPROCKET")
  providerShipmentId String?
  awb                String?
  status             ShipmentStatus @default(PENDING)
  idempotencyKey     String?        @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  createdById        String?
  updatedById        String?

  order     Order           @relation(fields: [orderId], references: [id])
  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id])
  events    ShipmentEvent[]
  labels    ShippingLabel[]

  @@index([orderId])
  @@index([status])
  @@index([awb])
  @@map("shipments")
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  status     ShipmentStatus
  payload    Json?
  occurredAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model ShippingLabel {
  id          String   @id @default(cuid())
  shipmentId  String
  storageKey  String
  labelType   String   @default("LABEL")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  createdById String?

  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId])
  @@map("shipping_labels")
}

model ServiceabilityRule {
  id             String   @id @default(cuid())
  postalCodeFrom String?
  postalCodeTo   String?
  city           String?
  countryCode    String   @default("IN")
  warehouseId    String?
  isServiceable  Boolean  @default(true)
  etaDaysMin     Int?
  etaDaysMax     Int?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  updatedById    String?

  @@index([postalCodeFrom, postalCodeTo])
  @@map("serviceability_rules")
}

