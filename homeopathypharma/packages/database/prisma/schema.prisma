  @@map("whatsapp_logs")
}

// ─── SEO / Content Ops ───────────────────────────────────────

model Page {
  id          String        @id @default(cuid())
  kind        PageKind
  title       String
  slugId      String?       @unique
  status      PublishStatus @default(DRAFT)
  ownerUserId String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  slug      Slug?          @relation(fields: [slugId], references: [id])
  versions  PageVersion[]
  seo       SeoMetadata?
  redirects PageRedirect[] @relation("RedirectFrom")

  @@index([kind, status])
  @@map("pages")
}

model PageVersion {
  id          String   @id @default(cuid())
  pageId      String
  version     Int
  title       String
  body        String
  changeNote  String?
  status      String   @default("SNAPSHOT")
  createdAt   DateTime @default(now())
  createdById String?

  page Page @relation(fields: [pageId], references: [id])

  @@unique([pageId, version])
  @@map("page_versions")
}

model PageRedirect {
  id          String   @id @default(cuid())
  fromPageId  String?
  fromPath    String   @unique
  toPath      String
  statusCode  Int      @default(301)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  fromPage Page? @relation("RedirectFrom", fields: [fromPageId], references: [id])

  @@map("page_redirects")
}

model Slug {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  slug        String
  locale      String   @default("en-IN")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  page    Page?
  history SlugHistory[]

  @@unique([slug, locale])
  @@unique([entityType, entityId, locale])
  @@map("slugs")
}

model SlugHistory {
  id          String   @id @default(cuid())
  slugId      String
  oldSlug     String
  newSlug     String
  locale      String   @default("en-IN")
  createdAt   DateTime @default(now())
  createdById String?

  slug Slug @relation(fields: [slugId], references: [id])

  @@index([oldSlug, locale])
  @@map("slug_history")
}

model SeoMetadata {
  id              String   @id @default(cuid())
  pageId          String   @unique
  metaTitle       String?
  metaDescription String?
  ogImageKey      String?
  robotsDirective String?  @default("index,follow")
  canonicalUrl    String?
  schemaJson      Json?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?
  updatedById     String?

  page Page @relation(fields: [pageId], references: [id])

  @@map("seo_metadata")
}

model CanonicalRule {
  id          String   @id @default(cuid())
  pattern     String
  canonicalTo String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@map("canonical_rules")
}

model Sitemap {
  id          String         @id @default(cuid())
  segment     SitemapSegment
  locale      String         @default("en-IN")
  fileKey     String?
  status      String         @default("ACTIVE")
  lastBuiltAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String?
  updatedById String?

  entries SitemapEntry[]

  @@unique([segment, locale])
  @@map("sitemaps")
}

model SitemapEntry {
  id         String    @id @default(cuid())
  sitemapId  String
  loc        String
  lastmod    DateTime?
  changefreq String?
  priority   Decimal?  @db.Decimal(2, 1)
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sitemap Sitemap @relation(fields: [sitemapId], references: [id])

  @@unique([sitemapId, loc])
  @@index([sitemapId])
  @@map("sitemap_entries")
}

model InternalLink {
  id             String   @id @default(cuid())
  fromEntityType String
  fromEntityId   String
  toEntityType   String
  toEntityId     String
  anchorText     String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  updatedById    String?

  @@index([fromEntityType, fromEntityId])
  @@index([toEntityType, toEntityId])
  @@map("internal_links")
}

model SearchQuery {
  id          String   @id @default(cuid())
  query       String
  locale      String   @default("en-IN")
  resultCount Int      @default(0)
  userId      String?
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([query, createdAt])
  @@map("search_queries")
}

// ─── Compliance ──────────────────────────────────────────────

model Consent {
  id          String      @id @default(cuid())
  userId      String
  consentType ConsentType
  version     String
  granted     Boolean
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, consentType, createdAt])
  @@map("consents")
}

model PrivacyEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventType String
  payload   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("privacy_events")
}

model DocumentAccessLog {
  id               String   @id @default(cuid())
  doctorDocumentId String?
  accessorUserId   String
  action           String
  ipAddress        String?
  createdAt        DateTime @default(now())

  doctorDocument DoctorDocument? @relation(fields: [doctorDocumentId], references: [id])

  @@index([doctorDocumentId, createdAt])
  @@index([accessorUserId, createdAt])
  @@map("document_access_logs")
}

model DataRetentionJob {
  id           String    @id @default(cuid())
  jobType      String
  status       String    @default("PENDING")
  payload      Json?
  scheduledFor DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?
  updatedById  String?

  @@index([status, scheduledFor])
  @@map("data_retention_jobs")
}

model LegalHoldFlag {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  reason      String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@unique([entityType, entityId])
  @@map("legal_hold_flags")
}

/// Maps commerce entities to content knowledge entities without merging page types
model EntityContentMap {
  id               String   @id @default(cuid())
  commerceType     String
  commerceId       String
  contentType      String
  contentId        String
  relationshipType String   @default("RELATED")
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String?
  updatedById      String?

  @@unique([commerceType, commerceId, contentType, contentId, relationshipType])
  @@index([contentType, contentId])
  @@map("entity_content_maps")
}

/// Admin moderation queue for product and doctor reviews
model ReviewModerationQueue {
  id             String                @id @default(cuid())
  reviewType     ReviewQueueType
  reviewId       String
  status         ReviewQueueItemStatus @default(PENDING)
  priority       Int                   @default(0)
  assigneeUserId String?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  createdById    String?
  updatedById    String?

  @@index([status, priority])
  @@index([reviewType, reviewId])
  @@index([assigneeUserId, status])
  @@map("review_moderation_queue")
}

// ─── Multidimensional Catalogue Graph ────────────────────────
// Categories ≠ body systems ≠ conditions ≠ remedies.
// Connect via relationship tables. Brands stay first-class.

model BrandManufacturerMap {
  id             String   @id @default(cuid())
  brandId        String
  manufacturerId String
  isPrimary      Boolean  @default(false)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  updatedById    String?

  brand        Brand        @relation(fields: [brandId], references: [id])
  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id])

  @@unique([brandId, manufacturerId])
  @@map("brand_manufacturer_map")
}

model BrandDocument {
  id           String    @id @default(cuid())
  brandId      String
  title        String
  storageKey   String
  documentType String
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId])
  @@map("brand_documents")
}

/// Controlled source classification (plant, mineral, chemical, animal, nosode, etc.)
model RemedySourceType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  remedies Remedy[]

  @@map("remedy_source_types")
}

/// Master homeopathic remedy entity — NOT the sellable SKU
model Remedy {
  id                  String              @id @default(cuid())
  name                String
  slug                String              @unique
  commonNames         String?
  scientificName      String?
  sourceTypeId        String?
  ingredientId        String?
  pharmacopoeialRefs  String?
  educationalSummary  String?
  status              PublishStatus       @default(DRAFT)
  medicalReviewStatus MedicalReviewStatus @default(PENDING)
  ownerUserId         String?
  publishedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  createdById         String?
  updatedById         String?
  deletedAt           DateTime?

  sourceType    RemedySourceType?    @relation(fields: [sourceTypeId], references: [id])
  ingredient    Ingredient?          @relation(fields: [ingredientId], references: [id])
  productMaps   ProductRemedyMap[]
  conditionMaps ConditionRemedyMap[]

  @@index([status, publishedAt])
  @@index([sourceTypeId])
  @@map("remedies")
}

model ProductRemedyMap {
  id          String   @id @default(cuid())
  productId   String
  remedyId    String
  isPrimary   Boolean  @default(true)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  product Product @relation(fields: [productId], references: [id])
  remedy  Remedy  @relation(fields: [remedyId], references: [id])

  @@unique([productId, remedyId])
  @@index([remedyId])
  @@map("product_remedy_map")
}

/// Decimal / Centesimal / LM — potencies are attributes, not categories
model PotencySystem {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  potencies Potency[]

  @@map("potency_systems")
}

/// Only potencies actually offered should be linked to variants — do not auto-fill all possible values
model Potency {
  id          String   @id @default(cuid())
  systemId    String
  code        String
  label       String
  sortOrder   Int      @default(0)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  system   PotencySystem    @relation(fields: [systemId], references: [id])
  variants ProductVariant[]

  @@unique([systemId, code])
  @@map("potencies")
}

/// Admin-extensible dosage forms (no code deploy to add forms)
model DosageForm {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  variants ProductVariant[]

  @@map("dosage_forms")
}

/// Shop-by health area discovery — NOT disease/treatment claim categories
model HealthArea {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  status      PublishStatus @default(DRAFT)
  ownerUserId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  products ProductHealthAreaMap[]

  @@index([status])
  @@map("health_areas")
}

model ProductHealthAreaMap {
  id           String   @id @default(cuid())
  productId    String
  healthAreaId String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?
  updatedById  String?

  product    Product    @relation(fields: [productId], references: [id])
  healthArea HealthArea @relation(fields: [healthAreaId], references: [id])

  @@unique([productId, healthAreaId])
  @@index([healthAreaId])
  @@map("product_health_area_map")
}

/// Admin-controlled badges — never auto "doctor recommended" without auditable link
model ProductBadge {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  products ProductBadgeMap[]

  @@map("product_badges")
}

model ProductBadgeMap {
  id          String    @id @default(cuid())
  productId   String
  badgeId     String
  status      String    @default("ACTIVE")
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  product Product      @relation(fields: [productId], references: [id])
  badge   ProductBadge @relation(fields: [badgeId], references: [id])

  @@unique([productId, badgeId])
  @@map("product_badge_map")
}

/// Educational link only — does NOT assert that a product treats a condition
model ConditionProductMap {
  id               String   @id @default(cuid())
  conditionId      String
  productId        String
  relationshipNote String?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String?
  updatedById      String?

  condition Condition @relation(fields: [conditionId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([conditionId, productId])
  @@map("condition_product_map")
}

model ConditionRemedyMap {
  id               String   @id @default(cuid())
  conditionId      String
  remedyId         String
  relationshipNote String?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String?
  updatedById      String?

  condition Condition @relation(fields: [conditionId], references: [id])
  remedy    Remedy    @relation(fields: [remedyId], references: [id])

  @@unique([conditionId, remedyId])
  @@map("condition_remedy_map")
}

/// Future-ready recurring purchase — enable only where legal/product rules allow
model SubscriptionPlan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  intervalDays Int
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?
  updatedById  String?

  subscriptions CustomerSubscription[]

  @@map("subscription_plans")
}

model CustomerSubscription {
  id          String    @id @default(cuid())
  customerId  String
  planId      String
  variantId   String?
  status      String    @default("PENDING")
  nextOrderAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([customerId, status])
  @@map("customer_subscriptions")
}
