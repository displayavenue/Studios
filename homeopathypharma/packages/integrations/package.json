{
  "name": "@homeopathypharma/integrations",
  "version": "0.1.0",
  "description": "Server-side integration interfaces for payments, shipping, storage, and notifications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
