# HomeopathyPharma.com — environment template
# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
APP_ENV=local

WEB_URL=http://localhost:3000
DOCTOR_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
API_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000

DATABASE_URL=postgresql://hp:hp_dev_password@localhost:5432/homeopathypharma?schema=public
DATABASE_POOL_SIZE=10

REDIS_URL=redis://localhost:6379
REDIS_PREFIX=hp:

SESSION_SECRET=change-me-to-a-long-random-secret-at-least-64-chars
SESSION_COOKIE_NAME=hp_session
SESSION_TTL_SECONDS=1209600
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_AUDIENCES=

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HomeopathyPharma <noreply@homeopathypharma.com>"

SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1
SHIPROCKET_WEBHOOK_SECRET=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=homeopathypharma
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio_secret
S3_PUBLIC_BASE_URL=http://localhost:9000/homeopathypharma
S3_FORCE_PATH_STYLE=true

OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_PREFIX=hp

LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

FEATURE_WHATSAPP=false
FEATURE_PET_CONSULTATIONS=true
FEATURE_MERCHANT_CENTER_EXPORT=true

ADMIN_ALLOWED_IPS=
ADMIN_REQUIRE_MFA=true

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
