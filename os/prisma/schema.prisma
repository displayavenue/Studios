generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  SUPER_ADMIN
  ADMIN
  SALES
  ACCOUNT_MANAGER
  PERFORMANCE_MARKETER
  CREATIVE
  FINANCE
  CLIENT_OWNER
  CLIENT_USER
  VIEWER
}

enum OrgType {
  INTERNAL
  CLIENT
  PROSPECT
}

enum OrgStatus {
  ACTIVE
  ONBOARDING
  PAUSED
  CHURNED
  PROSPECT
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum LeadPipelineStatus {
  NEW
  CONTACTED
  QUALIFIED
  STRATEGY_CALL
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Organization {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  type           OrgType          @default(CLIENT)
  status         OrgStatus        @default(PROSPECT)
  industry       String?
  location       String?
  website        String?
  logoUrl        String?
  billingEmail   String?
  gstin          String?
  healthScore    Float?
  healthLabel    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  memberships    Membership[]
  leads          Lead[]
  deals          Deal[]
  payments       Payment[]
  invoices       Invoice[]
  campaigns      Campaign[]
  adAccounts     AdvertisingAccount[]
  proposals      Proposal[]
  tasks          Task[]
  approvals      Approval[]
  reports        Report[]
  aiGenerations  AiGeneration[]
  auditLogs      AuditLog[]
  jobs           Job[]
  integrations   PlatformIntegration[]
  onboarding     OnboardingChecklist?
  settings       OrganizationSetting[]

  @@index([type, status])
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  phone          String?
  passwordHash   String?
  globalRole     GlobalRole   @default(VIEWER)
  isActive       Boolean      @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  memberships    Membership[]
  sessions       Session[]
  assignedLeads  Lead[]       @relation("LeadAssignee")
  assignedTasks  Task[]       @relation("TaskAssignee")
  auditLogs      AuditLog[]
  notifications  Notification[]
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           GlobalRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model RolePermission {
  id         String     @id @default(cuid())
  role       GlobalRole
  permission String
  createdAt  DateTime   @default(now())

  @@unique([role, permission])
  @@index([role])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String   @unique
  organizationId   String?
  expiresAt        DateTime
  ip               String?
  userAgent        String?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Lead {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  phone            String?
  company          String?
  website          String?
  industry         String?
  location         String?
  budget           Float?
  growthScore      Float?
  leadScore        Float?
  leadGrade        String?
  pipelineStatus   LeadPipelineStatus @default(NEW)
  source           String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  landingPage      String?
  referrer         String?
  campaignExternalId String?
  adExternalId     String?
  assigneeId       String?
  assignee         User?              @relation("LeadAssignee", fields: [assigneeId], references: [id])
  notes            String?
  optedOut         Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deals            Deal[]
  assessments      Assessment[]

  @@index([organizationId, pipelineStatus])
  @@index([organizationId, leadScore])
  @@index([email])
}

model Assessment {
  id             String   @id @default(cuid())
  organizationId String?
  leadId         String?
  lead           Lead?    @relation(fields: [leadId], references: [id])
  publicId       String   @unique @default(cuid())
  status         String   @default("started")
  answers        Json?
  growthScore    Float?
  scoreBreakdown Json?
  unlocked       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([leadId])
  @@index([publicId])
}

model Deal {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?    @relation(fields: [leadId], references: [id])
  title          String
  valueInr       Float    @default(0)
  stage          String   @default("qualification")
  status         String   @default("open")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
}

model Proposal {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  status         String   @default("draft")
  totalInr       Float    @default(0)
  content        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
}

model Payment {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amountInr         Float
  currency          String        @default("INR")
  purpose           String
  status            PaymentStatus @default(CREATED)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  razorpaySignature String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([organizationId, status])
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  amountInr      Float
  gstInr         Float    @default(0)
  status         String   @default("draft")
  dueAt          DateTime?
  paidAt         DateTime?
  lineItems      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model PlatformIntegration {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform       String
  status         String   @default("disconnected")
  externalId     String?
  encryptedTokens String?
  scopes         String[] @default([])
  meta           Json?
  connectedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, platform])
}

model AdvertisingAccount {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform       String   @default("meta")
  externalId     String
  name           String?
  currency       String?  @default("INR")
  status         String   @default("active")
  meta           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  campaigns      Campaign[]

  @@unique([organizationId, platform, externalId])
}

model Campaign {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccountId    String?
  adAccount      AdvertisingAccount? @relation(fields: [adAccountId], references: [id])
  platform       String   @default("meta")
  externalId     String?
  name           String
  objective      String?
  status         String   @default("draft")
  dailyBudgetInr Float?
  healthScore    Float?
  meta           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
  @@index([platform, externalId])
}

model Task {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  priority       String   @default("medium")
  status         String   @default("open")
  source         String?
  dueAt          DateTime?
  assigneeId     String?
  assignee       User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  relatedType    String?
  relatedId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
}

model Approval {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  title          String
  status         String   @default("pending")
  payload        Json?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
}

model Report {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  title          String
  status         String   @default("draft")
  pdfPath        String?
  content        Json?
  periodStart    DateTime?
  periodEnd      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, type])
}

model OnboardingChecklist {
  id             String   @id @default(cuid())
  organizationId String   @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          Json
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AiGeneration {
  id               String   @id @default(cuid())
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  feature          String
  model            String
  status           String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  estimatedCostUsd Float    @default(0)
  requestPayload   Json?
  responsePayload  Json?
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([organizationId, feature])
  @@index([createdAt])
}

model Job {
  id             String    @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  type           String
  status         JobStatus @default(PENDING)
  payload        Json?
  result         Json?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  runAfter       DateTime  @default(now())
  lockedAt       DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([organizationId, type])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entity         String?
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  priority  String   @default("medium")
  readAt    DateTime?
  href      String?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationSetting {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
}
